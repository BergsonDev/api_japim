type Role {
    id : ID!
    name : String!
    initialism : String!
    permissions : [Permission]!
    created_at : LocalDateTime!
    updated_at : LocalDateTime
    deleted_at : LocalDateTime
}

input InputRoleCreate {
    name : String!
    initialism : String!
    description : String
}

input InputRoleUpdate {
    id : ID!
    name : String!
    initialism : String!
    description : String
}

input InputRolePermission {
    id : ID!
    permissions_id : [ID]!
}

extend type Query {
    roles : [Role]!
    role(id : ID!) : Role
}

extend type Mutation {
    createRole(input : InputRoleCreate!) : Role!
    updateRole(input : InputRoleUpdate!) : Role!
    deleteRole(id : ID!) : Role!
    addPermission(input : InputRolePermission!) : Role!
    removePermission(input : InputRolePermission!) : Role!
}