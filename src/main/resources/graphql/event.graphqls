type Event{
    id: ID!
    name: String!
    short_description: String!
    description: String!
    path_img: String
    is_payment: Boolean!
    value: Float!
    max_participants: Int!
    max_volunteers: Int!
    date_start: Date!
    hour_start: LocalTime!
    date_end: Date!
    hour_end: LocalTime!
    workload: Int!
    created_by: User!
    status_event: StatusEvent!
    confirmed_by: User
    speakers: [User]!
    participants: [User]
    volunteers: [User]
    created_at: LocalDateTime!
    updated_at: LocalDateTime
    deleted_at: LocalDateTime
}

type EventParticipant{
    id: ID!
    name: String!
    short_description: String!
    description: String!
    path_img: String
    is_payment: Boolean!
    value: Float!
    max_participants: Int!
    date_start: Date!
    hour_start: LocalTime!
    date_end: Date!
    hour_end: LocalTime!
    workload: Int!
    speakers: [User]!
}

type EventVolunteer{
    id: ID!
    name: String!
    short_description: String!
    description: String!
    path_img: String
    is_payment: Boolean!
    value: Float!
    max_participants: Int!
    date_start: Date!
    hour_start: LocalTime!
    date_end: Date!
    hour_end: LocalTime!
    workload: Int!
    speakers: [User]!
    volunteers: [User]
}


input EventInputCreate{
    name: String!
    short_description: String!
    description: String!
    is_payment: Boolean!
    value: Float!
    max_participants: Int!
    max_volunteers: Int!
    date_start: Date!
    hour_start: LocalTime!
    date_end: Date!
    hour_end: LocalTime!
    workload: Int!
    speakers_id: [ID]!
}

input EventInputUpdate{
    id: ID!
    name: String!
    short_description: String!
    description: String!
    is_payment: Boolean!
    value: Float!
    max_participants: Int!
    max_volunteers: Int!
    date_start: Date!
    hour_start: LocalTime!
    date_end: Date!
    hour_end: LocalTime!
    workload: Int!
    speakers_id: [ID]!
}

extend type Query{
    events: [Event]
    event(id : ID!):Event! 
}

extend type Mutation{
    createEvent(input : EventInputCreate) : Event!
    updateEvent(input : EventInputUpdate) : Event!
    deleteEvent(id : ID!) : Event!
    subscribeParticipant(event_id: ID!) : EventParticipant!
    unsubscribeParticipant(event_id: ID!) : EventParticipant!
    subscribeVolunteer(event_id: ID!) : EventVolunteer!
    unsubscribeVolunteer(event_id: ID!) : EventVolunteer!
    confirmedEvent(id: ID!) : Event!
    confirmedPresenceByVolunteer(id: ID!, participant_id: ID!) : Event!
}