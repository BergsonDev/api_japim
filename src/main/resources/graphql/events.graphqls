type Event{
    id : ID!
    name : String!
    short_description : String!
    description : String!
    path_img : String
    is_payment : Boolean!
    value : Float!
    max_participants : Int!
    max_volunteers : Int!
    date_start : Date!
    hour_start : LocalTime!
    date_end : Date!
    hour_end : LocalTime!
    workload : Int!
    created_by : User!
    confirmed_by : User
    created_at : LocalDateTime!
    updated_at : LocalDateTime
    deleted_at : LocalDateTime
}

input EventInputCreate{
    name : String!
    short_description : String!
    description : String!
    is_payment : Boolean!
    value : Float!
    max_participants : Int!
    max_volunteers : Int!
    date_start : Date!
    hour_start : LocalTime!
    date_end : Date!
    hour_end : LocalTime!
    workload : Int!
}

input EventInputUpdate{
    id : ID!
    name : String!
    short_description : String!
    description : String!
    is_payment : Boolean!
    value : Float!
    max_participants : Int!
    max_volunteers : Int!
    date_start : Date!
    hour_start : LocalTime!
    date_end : Date!
    hour_end : LocalTime!
    workload : Int!
}

extend type Query{
    events: [Event]
    event(id : ID!):Event! 
}

extend type Mutation{
    createEvent(input : EventInputCreate) : Event
    updateEvent(input : EventInputUpdate) : Event
}